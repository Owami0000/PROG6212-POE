@model List<EnrolmentDto>
@{ ViewData["Title"] = "My events"; }
<div class="page-header">
    <h1>My events</h1>
    <a asp-action="Index" class="btn btn-primary">Find more events</a>
</div>

@if (Model.Count == 0)
{
    <div class="card card-rd p-5 text-center">
        <div class="display-4">👟</div>
        <h3 class="mt-2">You haven't entered any events yet</h3>
        <p class="text-secondary">Browse upcoming events and pick your category.</p>
        <div><a asp-action="Index" class="btn btn-primary">Browse events</a></div>
    </div>
}
else
{
    <div class="card card-rd">
        <div class="table-responsive">
            <table class="table table-rd align-middle mb-0">
                <thead><tr><th>Event</th><th>Category</th><th>Entered</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@e.CategoryName</td>
                        <td>@Format.Date(e.EnrolledAt)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">Details</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
