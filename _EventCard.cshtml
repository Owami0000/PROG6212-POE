@model EventDto
<div class="card card-rd event-card">
    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img class="event-banner" src="@Model.BannerImageUrl" alt="@Model.Name event banner" loading="lazy" />
    }
    else
    {
        <div class="event-banner-ph type-@Model.EventType.ToLower()" aria-hidden="true">@Format.TypeIcon(Model.EventType)</div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="type-badge">@Model.EventType</span>
            <span class="meta-line">@Format.Date(Model.EventDate)</span>
        </div>
        <h3 class="mb-1">@Model.Name</h3>
        <p class="meta-line mb-2">📍 @Model.Location &nbsp;·&nbsp; @Model.DistanceKm.ToString("0.##") km</p>
        <p class="small text-secondary flex-grow-1">@(Model.Description.Length > 110 ? Model.Description[..110] + "…" : Model.Description)</p>
        <a class="btn btn-primary mt-2" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View details</a>
    </div>
</div>
