@model EventFormVm
@{
    var isEdit = Model.EventId > 0;
}
<div class="card card-rd">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data"
              asp-action="@(isEdit ? "EditEvent" : "CreateEvent")"
              asp-route-id="@(isEdit ? Model.EventId : (int?)null)">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="any" min="0.1" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (!string.IsNullOrWhiteSpace(Model.ExistingBannerUrl))
                    {
                        <div class="mb-2"><img src="@Model.ExistingBannerUrl" alt="Current banner" class="img-fluid rounded" style="max-height:160px" /></div>
                    }
                    <img id="bannerPreview" src="" alt="Selected banner preview" class="img-fluid rounded mb-2 d-none" style="max-height:160px" />
                    <input asp-for="Banner" type="file" class="form-control" accept="image/*" data-preview="bannerPreview" />
                    <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. @(isEdit ? "Leave empty to keep the current banner." : "Optional.")</div>
                    <span asp-validation-for="Banner" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
