@{
    var role = Context.Session.GetString("Role");
    var userId = Context.Session.GetInt32("UserId");
    var displayName = Context.Session.GetString("DisplayName");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, string a) =>
        string.Equals(c, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(a, action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var homeLink = role == "Organiser" ? "Organiser" : role == "Participant" ? "Participant" : "Home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Home") · RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-raceday navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="@homeLink" asp-action="Index">Race<span>Day</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (userId == null)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                    }
                    else if (role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Index")" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Events")" asp-controller="Organiser" asp-action="Events">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Categories")" asp-controller="Organiser" asp-action="Categories">Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Enrolments")" asp-controller="Organiser" asp-action="Enrolments">Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Results")" asp-controller="Organiser" asp-action="Results">Results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Index")" asp-controller="Participant" asp-action="Index">Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "Profile")" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (userId == null)
                    {
                        <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Auth" asp-action="Register">Register</a>
                    }
                    else
                    {
                        <span class="text-white small">Hi, <strong>@displayName</strong></span>
                        <span class="role-pill">@role</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="footer-rd">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span><strong>RaceDay</strong> · Run. Walk. Cycle. Compete.</span>
        <span>© @DateTime.Now.Year RaceDay · PROG6212 PoE</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
