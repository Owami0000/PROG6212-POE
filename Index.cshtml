@model OrganiserDashboardVm
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-header">
    <h1>Organiser dashboard</h1>
    <a asp-action="CreateEvent" class="btn btn-primary">+ New event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card"><div class="stat-number">@Model.Events.Count</div><div class="stat-label">Events created</div></div></div>
    <div class="col-md-4"><div class="stat-card accent"><div class="stat-number">@Model.UpcomingEvents.Count</div><div class="stat-label">Upcoming events</div></div></div>
    <div class="col-md-4"><div class="stat-card lime"><div class="stat-number">@Model.TotalEnrolments</div><div class="stat-label">Total enrolments</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-rd">
            <div class="card-header">My events &amp; enrolments</div>
            @if (Model.Events.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <div class="display-4">📋</div>
                    <p class="text-secondary mt-2">You haven't created any events yet.</p>
                    <a asp-action="CreateEvent" class="btn btn-primary">Create your first event</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-rd align-middle mb-0">
                        <thead><tr><th>Event</th><th>Date</th><th>Type</th><th class="text-center">Enrolments</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var e in Model.Events)
                        {
                            <tr>
                                <td class="fw-semibold">@e.Name</td>
                                <td>@Format.Date(e.EventDate)</td>
                                <td><span class="type-badge">@e.EventType</span></td>
                                <td class="text-center"><span class="position-chip">@e.EnrolmentCount</span></td>
                                <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Enrolments" asp-route-eventId="@e.EventId">View</a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card card-rd">
            <div class="card-header">Upcoming dates</div>
            <ul class="list-group list-group-flush">
                @if (Model.UpcomingEvents.Count == 0)
                {
                    <li class="list-group-item text-secondary">No upcoming events.</li>
                }
                @foreach (var e in Model.UpcomingEvents)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div><div class="fw-semibold">@e.Name</div><div class="meta-line">@Format.Date(e.EventDate) · @e.Location</div></div>
                        <span class="badge text-bg-dark">@e.EnrolmentCount</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
