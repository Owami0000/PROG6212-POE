@model EventDetailsVm
@{
    ViewData["Title"] = Model.Event.Name;
    var ev = Model.Event;
    var backController = Model.IsParticipant ? "Participant" : "Organiser";
}
<a asp-controller="@backController" asp-action="Index" class="text-decoration-none">← Back</a>

<div class="mt-3 mb-4">
    @if (!string.IsNullOrWhiteSpace(ev.BannerImageUrl))
    {
        <img class="event-banner-lg" src="@ev.BannerImageUrl" alt="@ev.Name event banner" />
    }
    else
    {
        <div class="event-banner-ph lg type-@ev.EventType.ToLower()" aria-hidden="true">@Format.TypeIcon(ev.EventType)</div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card card-rd">
            <div class="card-body p-4">
                <span class="type-badge">@ev.EventType</span>
                <h1 class="mt-2 mb-3">@ev.Name</h1>
                <p>@ev.Description</p>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-4">Date</dt><dd class="col-sm-8">@Format.Date(ev.EventDate)</dd>
                    <dt class="col-sm-4">Location</dt><dd class="col-sm-8">📍 @ev.Location</dd>
                    <dt class="col-sm-4">Distance</dt><dd class="col-sm-8">@ev.DistanceKm.ToString("0.##") km</dd>
                    <dt class="col-sm-4">Organiser</dt><dd class="col-sm-8">@ev.OrganiserName</dd>
                    <dt class="col-sm-4">Entries</dt><dd class="col-sm-8">@ev.EnrolmentCount</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-rd">
            <div class="card-header">Categories</div>
            <div class="card-body">
                @if (Model.Categories.Count == 0)
                {
                    <p class="text-secondary mb-0">The organiser hasn't added any categories yet.</p>
                }
                else if (Model.IsParticipant && Model.MyEnrolment != null)
                {
                    <p class="mb-2">You're entered in <strong>@Model.MyEnrolment.CategoryName</strong>.</p>
                    <partial name="_StatusBadge" model="Model.MyEnrolment.Status" />
                    <div class="mt-3"><a asp-controller="Participant" asp-action="MyEvents" class="btn btn-outline-primary btn-sm">View my events</a></div>
                }
                else if (Model.IsParticipant)
                {
                    if (ev.EventDate.Date < DateTime.Today)
                    {
                        <p class="text-secondary mb-0">This event has already taken place.</p>
                    }
                    else
                    {
                        <form asp-controller="Participant" asp-action="EnterEvent" method="post">
                            <input type="hidden" name="eventId" value="@ev.EventId" />
                            <p class="small text-secondary">Choose a category and enter the event.</p>
                            @foreach (var c in Model.Categories)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="categoryId" id="cat@(c.CategoryId)" value="@c.CategoryId" required />
                                    <label class="form-check-label" for="cat@(c.CategoryId)">
                                        <strong>@c.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(c.Description)) { <span class="d-block small text-secondary">@c.Description</span> }
                                    </label>
                                </div>
                            }
                            <button type="submit" class="btn btn-primary w-100 mt-2">Enter event</button>
                        </form>
                    }
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var c in Model.Categories)
                        {
                            <li class="list-group-item px-0">
                                <strong>@c.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(c.Description)) { <span class="d-block small text-secondary">@c.Description</span> }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
